{
    "description": "",
    "type": "neos-package",
    "name": "sitegeist/kaleidoscope-valueobjects-migrations",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "neos/neos": "^8.3",
        "sitegeist/kaleidoscope-valueobjects": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Sitegeist\\Kaleidoscope\\ValueObjects\\Migrations\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sitegeist\\Kaleidoscope\\ValueObjects\\Migrations\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "fix:style": "phpcbf --colors --standard=PSR12 Classes Tests",
        "fix": ["composer install", "composer fix:style"],
        "test:style": "phpcs --colors -n --standard=PSR12 Classes Tests",
        "test:stan": "phpstan analyse Classes -v -c phpstan.neon",
        "test:unit": "phpunit Tests/Unit",
        "cc": "phpstan clear cache",
        "test": ["composer install", "composer test:style" , "composer test:stan", "composer test:unit"]
    },
    "extra": {
        "neos": {
            "package-key": "Sitegeist.Kaleidoscope.ValueObjects.Migrations"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    }
}
